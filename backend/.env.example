# アプリケーション設定
APP_NAME=tsubame-ci
DEBUG=True
API_VERSION=v1

# データベース設定
DATABASE_URL=postgresql+asyncpg://tsubame:tsubame@localhost:5432/tsubame_ci

# セキュリティ設定
SECRET_KEY=your-secret-key-here-change-in-production
ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# CORS設定
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# SSH設定
SSH_TIMEOUT=300
SSH_CONNECT_TIMEOUT=30
SSH_KEEPALIVE_INTERVAL_SECONDS=15
SSH_KEEPALIVE_COUNT_MAX=3
# detachedジョブ全体のtimeout。0で無制限。
EXECUTION_TIMEOUT_SECONDS=0
EXECUTION_SSH_OPERATION_TIMEOUT_SECONDS=30
EXECUTION_POLL_INTERVAL_SECONDS=2
EXECUTION_RECONNECT_MAX_INTERVAL_SECONDS=30
EXECUTION_LOG_CHUNK_BYTES=65536

# GitHubブランチポーリング設定
GITHUB_POLLING_ENABLED=True
GITHUB_POLL_INTERVAL_SECONDS=60
GITHUB_API_TIMEOUT_SECONDS=10

# サーバ定期監視設定
SERVER_MONITOR_ENABLED=True
SERVER_CHECK_INTERVAL_SECONDS=300
SERVER_CHECK_CONCURRENCY=5
SERVER_INVENTORY_TIMEOUT=15
